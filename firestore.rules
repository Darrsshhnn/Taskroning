rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == 'sdarshan1163@gmail.com' || 
         request.auth.token.admin == true);
    }

    // Connection test document
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // User profile documents
    match /users/{userId} {
      // Authenticated users can read team member profiles for directory & chat discovery
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      // Tasks sub-collection scoped strictly to user
      match /tasks/{taskId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if isOwner(userId) || isAdmin();
      }
    }

    // Team Chat Conversations
    match /conversations/{conversationId} {
      // Only participants or admins can read/list conversations
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.participants || isAdmin()
      );
      // Only authenticated users who include themselves in participants can create
      allow create: if isAuthenticated() && (
        request.auth.uid in request.resource.data.participants || isAdmin()
      );
      // Participants can update conversation metadata (lastMessage, lastMessageTime, updatedAt)
      allow update: if isAuthenticated() && (
        request.auth.uid in resource.data.participants || isAdmin()
      );
      allow delete: if isAdmin();

      // Subcollection for conversation messages
      match /messages/{messageId} {
        // Only conversation participants or admins can read messages
        allow read: if isAuthenticated() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants || isAdmin()
        );
        // Sender must be authenticated, senderId must match auth.uid, and user must be in conversation participants
        allow create: if isAuthenticated() && 
          request.resource.data.senderId == request.auth.uid &&
          (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants || isAdmin());
        allow update, delete: if isAuthenticated() && (
          resource.data.senderId == request.auth.uid || isAdmin()
        );
      }
    }
  }
}
