{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile tied 1:1 to Firebase Auth UID",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "profileImageType": { "type": "string", "enum": ["upload", "avatar"] },
        "role": { "type": "string" },
        "timeZone": { "type": "string" },
        "address": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "description": { "type": "string" },
        "skills": { "type": "array" },
        "leaves": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email", "name"]
    },
    "Task": {
      "title": "Task",
      "description": "User task item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "priority": { "type": "string" },
        "status": { "type": "string" },
        "category": { "type": "string" },
        "dueDate": { "type": "string" },
        "dueTime": { "type": "string" },
        "estimatedMinutes": { "type": "number" },
        "progress": { "type": "number" },
        "completed": { "type": "boolean" },
        "subtasks": { "type": "array" },
        "tags": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "title"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Team chat conversation thread",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "participants": { "type": "array" },
        "participantDetails": { "type": "object" },
        "isGroup": { "type": "boolean" },
        "groupName": { "type": "string" },
        "lastMessage": { "type": "string" },
        "lastMessageTime": { "type": "string" },
        "lastSenderId": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "participants"]
    },
    "Message": {
      "title": "Message",
      "description": "Chat message item in a conversation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "conversationId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderPhotoURL": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string" },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "conversationId", "senderId", "text"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile document"
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": "Task",
      "description": "User tasks collection"
    },
    "/conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "Team chat conversations"
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages subcollection in a conversation"
    }
  }
}
