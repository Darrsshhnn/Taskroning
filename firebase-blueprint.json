{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile tied 1:1 to Firebase Auth UID",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "profileImageType": { "type": "string", "enum": ["upload", "avatar"] },
        "role": { "type": "string" },
        "timeZone": { "type": "string" },
        "address": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "description": { "type": "string" },
        "skills": { "type": "array" },
        "leaves": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email", "name"]
    },
    "Task": {
      "title": "Task",
      "description": "User task item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "priority": { "type": "string" },
        "status": { "type": "string" },
        "category": { "type": "string" },
        "dueDate": { "type": "string" },
        "dueTime": { "type": "string" },
        "estimatedMinutes": { "type": "number" },
        "progress": { "type": "number" },
        "completed": { "type": "boolean" },
        "subtasks": { "type": "array" },
        "tags": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "title"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile document"
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": "Task",
      "description": "User tasks collection"
    }
  }
}
